# 复制为 .env 后填写；不要将 .env 提交到 Git
MYSQL_ROOT_PASSWORD=请改为强密码
MYSQL_DATABASE=sandbox
MYSQL_USER=sandbox
MYSQL_PASSWORD=请改为强密码

# 容器内由 docker-compose 覆盖为 db:3306，本地若直连 MySQL 可写 localhost
MYSQL_HOST=db
MYSQL_PORT=3306

DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-reasoner

# 生产建议设置
# DJANGO_SECRET_KEY=随机长字符串
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=你的域名或公网IP
